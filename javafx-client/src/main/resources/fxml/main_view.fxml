<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ru.mirea.archive.controller.MainController">

    <top>
        <VBox>
            <HBox styleClass="toolbar-panel" alignment="CENTER_LEFT" spacing="12">
                <Label text="Архив документов" styleClass="title-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnStatistics" text="Статистика" styleClass="btn-warning" onAction="#onShowStatistics"/>
                <Button fx:id="btnExportXlsx" text="Экспорт XLSX" styleClass="btn-export" onAction="#onExportXlsx"/>
                <Button fx:id="btnExportCsv" text="Экспорт CSV" styleClass="btn-export" onAction="#onExportCsv"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">

            <Tab text="Запросы на документы">
                <VBox spacing="10">
                    <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="+ Добавить" styleClass="btn-success" onAction="#onAddRequest"/>
                        <Button text="Редактировать" styleClass="btn-primary" onAction="#onEditRequest"/>
                        <Button text="Удалить" styleClass="btn-danger" onAction="#onDeleteRequest"/>
                        <Button text="Изменить статус" styleClass="btn-warning" onAction="#onChangeStatus"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Обновить" onAction="#onRefreshRequests"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-panel">
                        <Label text="Поиск:"/>
                        <TextField fx:id="searchRequestField" promptText="Название документа..." prefWidth="200"
                                   onAction="#onSearchRequests"/>
                        <Button text="Найти" onAction="#onSearchRequests"/>

                        <Separator orientation="VERTICAL"/>

                        <Label text="Статус:"/>
                        <ComboBox fx:id="filterStatusCombo" prefWidth="150" onAction="#onFilterRequests"/>

                        <Label text="Приоритет:"/>
                        <ComboBox fx:id="filterPriorityCombo" prefWidth="140" onAction="#onFilterRequests"/>

                        <Separator orientation="VERTICAL"/>

                        <Label text="Сортировка:"/>
                        <ComboBox fx:id="sortRequestCombo" prefWidth="170" onAction="#onSortRequests"/>

                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Сбросить" onAction="#onResetRequestFilters"/>
                    </HBox>

                    <TableView fx:id="requestTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="reqIdCol" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="reqTitleCol" text="Документ" prefWidth="220"/>
                            <TableColumn fx:id="reqCategoryCol" text="Категория" prefWidth="130"/>
                            <TableColumn fx:id="reqStatusCol" text="Статус" prefWidth="120"/>
                            <TableColumn fx:id="reqPriorityCol" text="Приоритет" prefWidth="110"/>
                            <TableColumn fx:id="reqUserCol" text="Пользователь" prefWidth="170"/>
                            <TableColumn fx:id="reqCreatedCol" text="Создан" prefWidth="140"/>
                            <TableColumn fx:id="reqUpdatedCol" text="Обновлён" prefWidth="140"/>
                        </columns>
                        <placeholder>
                            <Label text="Нет данных для отображения" style="-fx-text-fill: #6c7086;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="Пользователи">
                <VBox spacing="10">
                    <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="+ Добавить" styleClass="btn-success" onAction="#onAddUser"/>
                        <Button text="Редактировать" styleClass="btn-primary" onAction="#onEditUser"/>
                        <Button text="Удалить" styleClass="btn-danger" onAction="#onDeleteUser"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Обновить" onAction="#onRefreshUsers"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-panel">
                        <Label text="Поиск по ФИО:"/>
                        <TextField fx:id="searchUserField" promptText="Введите имя..." prefWidth="250"
                                   onAction="#onSearchUsers"/>
                        <Button text="Найти" onAction="#onSearchUsers"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Сбросить" onAction="#onResetUserFilters"/>
                    </HBox>

                    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="userIdCol" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="userNameCol" text="ФИО" prefWidth="250"/>
                            <TableColumn fx:id="userEmailCol" text="Email" prefWidth="220"/>
                            <TableColumn fx:id="userPhoneCol" text="Телефон" prefWidth="160"/>
                            <TableColumn fx:id="userDeptCol" text="Отдел" prefWidth="180"/>
                            <TableColumn fx:id="userCreatedCol" text="Дата регистрации" prefWidth="160"/>
                        </columns>
                        <placeholder>
                            <Label text="Нет данных для отображения" style="-fx-text-fill: #6c7086;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="20">
            <Label fx:id="statusLabel" text="Готово"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" text=""/>
        </HBox>
    </bottom>

</BorderPane>
