<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.mirea.archive.controller.AuthDialogController"
      spacing="16" prefWidth="440">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <VBox spacing="4" alignment="CENTER">
        <Label text="Вход в «Архив документов»" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #89b4fa;"/>
        <Label text="Авторизация через Spring Boot REST API" style="-fx-text-fill: #a6adc8; -fx-font-size: 12px;"/>
    </VBox>

    <TabPane fx:id="authTabPane" tabClosingPolicy="UNAVAILABLE">
        <Tab text="Вход">
            <VBox spacing="12">
                <padding><Insets top="16" right="8" bottom="8" left="8"/></padding>

                <VBox spacing="4">
                    <Label text="Логин:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="loginUsernameField" promptText="admin" text="admin"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Пароль:" style="-fx-font-weight: bold;"/>
                    <PasswordField fx:id="loginPasswordField" promptText="admin123" text="admin123"/>
                </VBox>

                <VBox spacing="2" style="-fx-background-color: #313244; -fx-padding: 8 12; -fx-background-radius: 6;">
                    <Label text="Данные для старта хранятся в backend/.env" style="-fx-font-size: 11px; -fx-text-fill: #f9e2af; -fx-font-weight: bold;"/>
                    <Label text="Логин: admin | Пароль: admin123" style="-fx-font-size: 11px; -fx-text-fill: #cdd6f4;"/>
                </VBox>

                <Button fx:id="btnLogin" text="Войти в систему" styleClass="btn-primary" maxWidth="Infinity" onAction="#onLogin"/>
            </VBox>
        </Tab>

        <Tab text="Регистрация">
            <VBox spacing="10">
                <padding><Insets top="16" right="8" bottom="8" left="8"/></padding>

                <VBox spacing="4">
                    <Label text="Логин:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="regUsernameField" promptText="ivanov"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="ФИО:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="regFullNameField" promptText="Иванов Иван Иванович"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Email:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="regEmailField" promptText="ivanov@mirea.ru"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Пароль:" style="-fx-font-weight: bold;"/>
                    <PasswordField fx:id="regPasswordField" promptText="Минимум 4 символа"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Подтверждение пароля:" style="-fx-font-weight: bold;"/>
                    <PasswordField fx:id="regConfirmPasswordField" promptText="Повторите пароль"/>
                </VBox>

                <Button fx:id="btnRegister" text="Зарегистрироваться" styleClass="btn-success" maxWidth="Infinity" onAction="#onRegister"/>
            </VBox>
        </Tab>
    </TabPane>

    <Label fx:id="statusLabel" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #f38ba8;"/>
</VBox>
