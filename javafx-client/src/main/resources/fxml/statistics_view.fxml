<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns:fx="http://javafx.com/fxml" fx:controller="ru.mirea.archive.controller.StatisticsController"
            prefWidth="700" prefHeight="520">

    <headerText>Статистика системы</headerText>

    <content>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                <Label text="Общие показатели" styleClass="section-label"/>
                <HBox spacing="16" alignment="CENTER">
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="4">
                        <Label fx:id="totalRequestsLabel" text="0" styleClass="stat-value"/>
                        <Label text="Всего запросов" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="4">
                        <Label fx:id="totalUsersLabel" text="0" styleClass="stat-value"/>
                        <Label text="Пользователей" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="4">
                        <Label fx:id="totalCategoriesLabel" text="0" styleClass="stat-value"/>
                        <Label text="Категорий" styleClass="stat-label"/>
                    </VBox>
                </HBox>

                <Separator/>

                <Label text="По статусам" styleClass="section-label"/>
                <HBox spacing="12" alignment="CENTER" fx:id="statusStatsBox">
                </HBox>

                <Separator/>

                <Label text="По приоритетам" styleClass="section-label"/>
                <HBox spacing="12" alignment="CENTER" fx:id="priorityStatsBox">
                </HBox>

                <Separator/>

                <Label text="Категории документов" styleClass="section-label"/>
                <VBox fx:id="categoryStatsBox" spacing="6">
                </VBox>
            </VBox>
        </ScrollPane>
    </content>

    <buttonTypes>
        <ButtonType fx:constant="CLOSE"/>
    </buttonTypes>

</DialogPane>
