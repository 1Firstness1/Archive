# ==============================================================================
# Шаблон переменных окружения (Пример конфигурации для развёртывания)
# Скопируйте этот файл в .env и укажите ваши реальные значения секретов:
#   cp .env.example .env
# ==============================================================================

# 1. Параметры подключения к PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=archive_db
DB_USER=archive_user
DB_PASSWORD=your_secure_db_password_here

# 2. Сетевые порты
SERVER_PORT=8080

# 3. Настройки JWT (JSON Web Token)
# Секретный ключ подписи (256-битный секрет)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_placeholder
# Время жизни access JWT (15 минут = 900 000 мс)
JWT_ACCESS_EXPIRATION_MS=900000
# Время жизни refresh токена (7 дней = 604 800 000 мс)
JWT_REFRESH_EXPIRATION_MS=604800000

# 4. Начальные учетные данные администратора системы
INIT_ADMIN_LOGIN=admin
INIT_ADMIN_PASSWORD=your_admin_initial_password_here
INIT_ADMIN_NAME=Главный Администратор
INIT_ADMIN_EMAIL=admin@mirea.ru

# 5. Разрешённые CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080
